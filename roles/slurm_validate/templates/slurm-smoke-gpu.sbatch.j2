#!/bin/bash
#SBATCH -J smoke-gpu
#SBATCH -p {{ slurm_validate_partitions.gpu }}
#SBATCH -N 1
#SBATCH -n 1
#SBATCH -o gpu_%j.out
#SBATCH -e gpu_%j.err
#SBATCH -c 2
#SBATCH --gres=gpu:1
#SBATCH -t 00:02:00

set -euo pipefail
echo "=== GPU smoke ==="
date
hostname
pwd
nvidia-smi -L
nvidia-smi
echo "OK"
