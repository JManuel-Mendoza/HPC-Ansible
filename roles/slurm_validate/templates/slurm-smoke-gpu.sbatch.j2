#!/bin/bash
{# Proposito: Renderizar plantilla del rol 'slurm_validate' para ejecutar validaciones read-only de Slurm y smoke jobs. #}
{# Supuestos/prerrequisitos: El archivo destino debe existir con permisos definidos por la task de template en el rol. #}
{# Variables clave consumidas: slurm_validate_partitions #}
{# Estructura de salida y ramas condicionales: El render respeta condicionales y bucles Jinja para adaptar configuracion por host/grupo. #}
{# Tags relevantes: Heredadas del task que invoca template dentro del rol. #}

#SBATCH -J smoke-gpu
#SBATCH -p {{ slurm_validate_partitions.gpu }}
#SBATCH -N 1
#SBATCH -n 1
#SBATCH -o gpu_%j.out
#SBATCH -e gpu_%j.err
#SBATCH -c 2
#SBATCH --gres=gpu:1
#SBATCH -t 00:02:00

set -euo pipefail
echo "=== GPU smoke ==="
date
hostname
pwd
nvidia-smi -L
nvidia-smi
echo "OK"
